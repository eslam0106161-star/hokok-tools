{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UECS Concept",
  "type": "object",
  "required": [
    "concept_id",
    "title",
    "importance",
    "source_refs"
  ],
  "properties": {
    "concept_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "importance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "source_refs": {
      "type": "array"
    },
    "source_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "relations": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
